---
import BaseLayout from "../layouts/BaseLayout.astro";
import Publications from "../components/Publications.astro";
import Projects from "../components/Projects.astro";
import Internships from "../components/Internships.astro";
import { site } from "../data/site";

const introParagraphs = Array.isArray(site.profile.intro)
  ? site.profile.intro
  : [site.profile.intro];
---

<BaseLayout title={site.title} description={site.description}>
  <section class="hero">
    <div class="photo-area">
      {
        site.profile.photoSrc ? (
          <img src={site.profile.photoSrc} alt={site.profile.photoAlt} loading="eager" />
        ) : (
          <div class="photo-placeholder" aria-label="Photo placeholder">
            Photo
          </div>
        )
      }
      <div class="profile-links" aria-label="Profile links">
        {site.links.filter((link) => link.label !== "Email").map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
      <p class="profile-email">ericycc [at] tamu [dot] edu</p>
    </div>
    <div class="hero-copy">
      <h1>{site.profile.name}</h1>
      {
        introParagraphs.map((paragraph) => (
          <p class="intro">
            {
              Array.isArray(paragraph)
                ? paragraph.map((part) =>
                    typeof part === "string" ? part : <a href={part.href}>{part.label}</a>,
                  )
                : paragraph
            }
          </p>
        ))
      }
    </div>
  </section>

  <section class="section two-column" aria-labelledby="research-heading">
    <div class="section-heading">
      <h2 id="research-heading">Research Interests</h2>
    </div>
    <ul class="tag-list">
      {site.researchInterests.map((interest) => <li>{interest}</li>)}
    </ul>
  </section>

  <Publications />
  <Projects />
  <Internships />

  <aside class="fun-fact" aria-label="Fun fact">
    <p>
      <strong>Fun fact:</strong> I passed China’s National Unified Legal Professional Qualification
      Examination (国家统一法律职业资格考试) in 2021. I’m always happy to chat about the intersection
      of technology and law.
    </p>
  </aside>
</BaseLayout>
